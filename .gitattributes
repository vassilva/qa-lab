# Files used inside the Linux containers: always with Linux line endings (LF),
# even when the repository is edited on Windows (avoids "bad interpreter" and "\r" errors)
*.sh        text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
Jenkinsfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.ps1       text eol=crlf
